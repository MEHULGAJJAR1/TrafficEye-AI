# Copy to .env. Never put a real key into source control.
# Relative paths, when set below, are interpreted relative to the project root by scripts.
# Best beginner setup: leave the path variables unset and use the defaults.
# TE_DATA_DIR=C:/TrafficEyeData
# TE_MODEL_DIR=C:/TrafficEyeModels
# TE_SAMPLE_DIR=C:/TrafficEye-AI/samples
TE_MAX_UPLOAD_MB=500
TE_MAX_VIDEO_SECONDS=7200
TE_MAX_QUEUED_JOBS=4
TE_TORCH_THREADS=2
TE_DEMO_DELAY=0.025
# Empty means generate a random local access key in data/access.key on first run.
# If set, use at least 24 characters and keep it secret. No default key is supplied.
TE_API_KEY=
# True only for HTTPS. Leave false on local HTTP.
TE_SECURE_COOKIE=false
# JSON array; exact origins, not a wildcard. Vite's same-origin proxy avoids CORS.
TE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:8000"]
# Consumed by Vite only; restart the frontend after changing it.
# Set it in PowerShell: $env:TE_BACKEND_URL='http://127.0.0.1:8000'
